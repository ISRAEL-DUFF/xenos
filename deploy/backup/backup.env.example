# /etc/xenos/backup.env  (chmod 600, owner xenos)
DATABASE_URL=postgres://xenos:CHANGE_ME@localhost:5432/xenos?sslmode=disable
# The restore test needs a role that may CREATE DATABASE on the same server.
ADMIN_URL=postgres://postgres:CHANGE_ME@localhost:5432/postgres?sslmode=disable
LIVE_URL=postgres://xenos:CHANGE_ME@localhost:5432/xenos?sslmode=disable
BACKUP_DIR=/var/backups/xenos
RETENTION_DAYS=14
# Hetzner Storage Box: SSH on port 23, key-only.
REMOTE=u123456@u123456.your-storagebox.de:xenos-db/
RSYNC_SSH=ssh -p 23 -i /etc/xenos/storagebox_key -o StrictHostKeyChecking=yes
# Optional dead-man switch: pinged after each successful backup (e.g. healthchecks.io).
HEALTHCHECK_URL=
