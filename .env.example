# Production: keep this on loopback behind Caddy and firewall 8080
XENOS_HTTP_ADDR=127.0.0.1:8080
# "production" refuses to start without real iSpend, SMTP and secure cookies
XENOS_ENV=development
# Development: run the worker (jobs + metering) inside the API process. Needed with the fake iSpend,
# whose state lives in one process. In production run cmd/worker separately, exactly one instance.
XENOS_RUN_WORKER=false
XENOS_DATABASE_URL=postgres://xenos:xenos@localhost:5432/xenos?sslmode=disable
XENOS_REGION=eu-de-1
XENOS_PUBLIC_URL=http://localhost:8080
# Secure cookies need HTTPS; set false for local http development only
XENOS_COOKIE_SECURE=false
# true only when behind Caddy (reads the rightmost X-Forwarded-For entry)
XENOS_TRUST_PROXY=false
# Proxies besides loopback whose X-Forwarded-For is believed (space or comma separated IPs/CIDRs)
XENOS_TRUSTED_PROXIES=

# Transactional email (any SMTP provider; port 465 = TLS, otherwise STARTTLS is required).
# Empty in development: emails, including reset links, are written to the log.
XENOS_SMTP_HOST=
XENOS_SMTP_PORT=587
XENOS_SMTP_USER=
XENOS_SMTP_PASS=
XENOS_MAIL_FROM=

# Proxmox
XENOS_PVE_URL=https://pve.example.com:8006
XENOS_PVE_NODE=pve
XENOS_PVE_TOKEN_ID=xenos@pve!control
XENOS_PVE_TOKEN_SECRET=
XENOS_PVE_STORAGE=vmdata
XENOS_PVE_BRIDGE=vmbr0
XENOS_PVE_DISK=scsi0
# Self-signed Proxmox cert: set true until a real certificate is installed
XENOS_PVE_INSECURE_TLS=false
# Test hosts with no KVM: run guests under software emulation (very slow)
XENOS_PVE_DISABLE_KVM=false
# How long to wait for a new VM's guest agent; raise a lot when KVM is disabled
XENOS_PROVISION_TIMEOUT=3m
XENOS_WORKER_CONCURRENCY=4
# Prefix length for each VM's IPv4 address (routed setups use 32)
XENOS_IPV4_PREFIX_LEN=32
# Optional IPv6: allocate VM addresses from this /64
XENOS_IPV6_PREFIX=
XENOS_IPV6_GATEWAY=
XENOS_NAMESERVERS=1.1.1.1 9.9.9.9

# iswallet (iSpend). Leave XENOS_ISPEND_URL empty to use the in-memory fake.
XENOS_ISPEND_URL=
XENOS_ISPEND_API_KEY=
# Optional override. By default charges go to the tenant's operating wallet from GET /v1/platform/account
# (iswallet provisions one per tenant; do not create a second "merchant" wallet).
XENOS_ISPEND_MERCHANT_WALLET=
# Decimal places of iswallet's USDT minor unit: 6 (micro-USDT). Used as a guard: a balance response with
# a different scale is refused.
XENOS_ISPEND_USDT_DECIMALS=6
# owner_ref is unique across ALL iswallet tenants and sandbox is never reset: use a distinct prefix per environment.
XENOS_ISPEND_OWNER_PREFIX=xenos
# HMAC signing secret from `xenosctl ispend subscribe <url>` (shown once); empty rejects every webhook
XENOS_ISPEND_WEBHOOK_SECRET=
# Spread each VM's hourly charge over this many minutes (iswallet allows 100 calls/min per key)
XENOS_METER_SPREAD_MINUTES=40
# Basic (TIER_1) accounts can receive this much per transfer and per day; shown to customers, 0 hides it
XENOS_DEPOSIT_LIMIT_KOBO=5000000
# With the fake iSpend (URL empty), give each new customer this much USDT credit (micro-USDT)
XENOS_FAKE_ISPEND_CREDIT_UUSDT=

# Operator alerts (failed jobs, pool/RAM thresholds, stuck billing, webhook probing, flagged VMs).
# Configure Telegram (both values) and/or an email address. With none, alerts only reach the log.
XENOS_TELEGRAM_BOT_TOKEN=
XENOS_TELEGRAM_CHAT_ID=
XENOS_ALERT_EMAIL=
